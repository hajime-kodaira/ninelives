<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.local.ninelives</string>

	<key>ProgramArguments</key>
	<array>
		<string>__BIN__</string>
		<string>-out</string>
		<string>__OUT__</string>
		__EXTRA_ARGS__
	</array>

	<!-- The usage endpoint rate-limits aggressively. Do not go below 300. -->
	<key>StartInterval</key>
	<integer>300</integer>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
